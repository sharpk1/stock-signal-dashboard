ANTHROPIC_API_KEY=your_key_here

# Which Claude model each job uses (C2). Summaries and chat run on Sonnet so
# the analysis reads well and reasons at a high level; ticker extraction is a
# narrow structured pull, so it stays on the cheaper Haiku. Leave unset for
# these defaults.
# SUMMARY_MODEL=claude-sonnet-5-5
# CHAT_MODEL=claude-sonnet-5-5
# EXTRACT_MODEL=claude-haiku-4-5-20251001
SUBSTACK_SESSION_COOKIE=your_substack_sid_cookie_here
# A session cookie carries no readable expiry, so set this to the date you
# pasted the cookie above and the fetch will warn you weeks before it dies
# (B5). Leave it unset and no age warning is raised.
# SUBSTACK_COOKIE_SET_AT=2026-10-29
# SUBSTACK_COOKIE_MAX_AGE_DAYS=75

# YouTube Data API v3 key (RAY-24). The public RSS feed goes down for every
# channel every so often; when it does, video listing falls back to the Data API
# (playlistItems.list, 1 quota unit per channel per run). Leave it unset and a
# feed outage simply fails the pull, as it did before the fallback existed.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Webshare rotating residential proxy (YouTube blocks data-center IPs for transcripts)
WEBSHARE_PROXY_USERNAME=your_webshare_username
WEBSHARE_PROXY_PASSWORD=your_webshare_password
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80

# Turso / libSQL database. Leave unset locally to use the local file (file:data/signals.db).
# Set both in production (Vercel) to point at your Turso database.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Auto-fetch cron (ALT-7). CRON_SECRET secures /api/cron and /api/fetch — Vercel
# Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=any_long_random_string
# Email digest of newly-pulled videos (Postmark). EMAIL_FROM must be a verified
# Postmark sender signature or on a verified sending domain (e.g. @altiro.io).
POSTMARK_SERVER_TOKEN=your_postmark_server_token
NOTIFY_EMAIL=recipient@example.com
EMAIL_FROM=signals@altiro.io
# Failure alerts (A4): who hears when a source breaks or the AI credit runs
# out. Comma-separated; falls back to NOTIFY_EMAIL when unset.
ALERT_EMAILS=ray@example.com,kush@altiro.io
# POSTMARK_MESSAGE_STREAM=outbound  # optional; defaults to "outbound"
NEXT_PUBLIC_APP_URL=https://stock-signal-dashboard-nine.vercel.app
